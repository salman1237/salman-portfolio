# Postgres (used by docker-compose.yml and Prisma)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# Full connection string Prisma uses. Inside docker-compose, host is the
# `postgres` service name; running the app outside Docker, use localhost
# and the port you've mapped (see docker-compose.override.yml for local dev).
DATABASE_URL=postgresql://portfolio:CHANGE_ME@postgres:5432/portfolio

# Admin login (single account, no user table)
ADMIN_USERNAME=
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign the admin session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Uploaded images (project covers, profile photo) are written to
# public/uploads and served as static files. docker-compose.yml mounts a
# volume there so they survive redeploys — no env var needed for this.
